{
  "name": "businesssim",
  "productName": "BusinessSim",
  "version": "1.7.0",
  "description": "Top-down 2D business tycoon game",
  "author": "BusinessSim",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --publish never -c.win.signAndEditExecutable=false",
    "icon": "node scripts/make-icon.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "phaser": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NoVanity99/BusinessSim.git"
  }
}
